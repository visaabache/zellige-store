{
  "name": "dar-zellij-store",
  "version": "1.0.0",
  "description": "Dar Zellij: multilingual (AR/FR/EN) cash-on-delivery zellige ceramics store on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev --assets ./public",
    "db:migrate:local": "wrangler d1 migrations apply zellige-store --local",
    "db:seed:local": "wrangler d1 execute zellige-store --local --file seed/catalogue.sql",
    "db:migrate": "wrangler d1 migrations apply zellige-store --remote",
    "db:seed": "wrangler d1 execute zellige-store --remote --file seed/catalogue.sql",
    "upload:static": "node scripts/upload-static.mjs",
    "deploy": "node scripts/upload-static.mjs && wrangler deploy",
    "test": "node --test test/*.test.js",
    "db:reset:local": "node -e \"require('fs').rmSync('.wrangler/state',{recursive:true,force:true})\" && npm run db:migrate:local && npm run db:seed:local"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  }
}
