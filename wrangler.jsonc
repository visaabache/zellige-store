// Cloudflare Worker for the Dar Zellij store: plain JavaScript (no framework, no build step) and a D1 database,
// so pages render in a few milliseconds of CPU and the store fits Cloudflare's free plan.
{
  "name": "zellige-store",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Static files (public/: photos, CSS, JS, the admin app) live in this KV namespace, uploaded by
  // `npm run upload:static` before each deploy (see src/static.js). Local development serves public/ directly.
  "kv_namespaces": [{ "binding": "STATIC", "id": "edf39d16217243eabbba0de76431a745" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zellige-store",
      "database_id": "4ee11d86-5c0f-41f5-a40f-e9864732d160",
      "migrations_dir": "migrations"
    }
  ],
  // The store's public address: canonical links, sitemap, structured data and email links.
  "vars": { "SITE_URL": "https://zellige-store.visa-abache.workers.dev" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
